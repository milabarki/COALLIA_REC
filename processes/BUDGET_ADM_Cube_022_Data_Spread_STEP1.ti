#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


####################################
# Process : BUDGET_ADM_Cube_022_Data_Spread_STEP1
# Description : 022 Unknow geo clean
# Created by : MBO
# Date : 08/10/2018
####################################


# ==================================================================================
# --  VARIABLES
# ==================================================================================
sCubeSource = '022_Input_Pilot';


IF(pType@='SEA');
	pIndicator = 'TEUS';
ELSE;
	pIndicator = 'CW';
ENDIF;

vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewName = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName,1);

#-- Subset creation on dimension Scenario
sDim = 'Scenario';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'BUDGET_N+1' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Organization
sDim = 'Organization_Pilot';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;

IF ( ELLEV( sDim , pOrganization ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pOrganization , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pOrganization, vElt ) <> 0 & ELLEV( sDim, vElt )=0);
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Loading_Location
sDim = 'Loading_Location';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'XXXXX' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Offloading_Location
sDim = 'Offloading_Location';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;

SubsetElementInsert( sDim , sSubsetName , 'XXXXX' , 1 );


ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Indicators_Pilot
sDim = 'Indicators_Pilot';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , pIndicator , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


ViewZeroOut( sCubeSource, sViewName );

# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****



