# ==================================================================================
# -- WORKFLOW INIT
# ==================================================================================


vDimTarget = ' Organization_pilot';
i = 1;
iMax = DIMSIZ ( vDimTarget ) ;
WHILE( i <= iMax );
	vElt = DIMNM ( vDimTarget ,  i );
	CELLPUTS( 'Unlock' , sCubeTarget6 , 'BUDGET_N+1' ,'AIR', vElt , 'Availability');
	CELLPUTS( 'Unlock' , sCubeTarget6 , 'BUDGET_N+1' ,'SEA', vElt , 'Availability');

	IF(DIMIX('Organization',vElt ) <> 0 );
		CELLPUTS( 'Unlock' , sCubeTarget6 , 'FCT_N' , 'OPS' , vElt , 'Availability');
		CELLPUTS( 'Unlock' , sCubeTarget6 , 'BUDGET_N+1' ,'OPS', vElt , 'Availability');
	ELSE;
	# Lock specific PILOT perimeter 
		IF( CELLISUPDATEABLE(sCubeTarget6 , 'FCT_N' , 'OPS' , vElt , 'Availability') = 1 );
			CELLPUTS( 'Lock' , sCubeTarget6 , 'FCT_N' , 'OPS' , vElt , 'Availability');
			CELLPUTS( 'Lock' , sCubeTarget6 , 'BUDGET_N+1' ,'OPS', vElt , 'Availability');
		ENDIF;
	ENDIF;

	i = i +1; 
END;




