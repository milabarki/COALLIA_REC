#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****

IF( SCAN( 'R_' , vElt ) <> 0 % SCAN( 'C_' , vElt ) <> 0 );
	vOrga = SUBST( vElt , 3 , LONG(vElt) - 2 );
	IF( DIMIX( sDimOrga1 , vOrga ) = 0 & DIMIX( sDimOrga2 , vOrga ) = 0 & DIMIX( sDimOrga3 , vOrga ) = 0 );
		DimensionElementDelete( '}Groups' , vElt );
	ENDIF;
ENDIF;
