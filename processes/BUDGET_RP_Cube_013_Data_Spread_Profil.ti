#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


####################################
# Process : BUDGET_RP_Cube_013_Data_Spread_Profil
# Description : 013 Data Spread only GM
# Created by : MBO
# Date : 26/06/2019
####################################

# ==================================================================================
# --  PROCESS CONTROL
# ==================================================================================

# Control
IF ( pStatus @<> 'N');
	PROCESSQUIT;
ENDIF;

# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCubeSource = '013_OPS_Monthly_Breakdown' ;
sCubeTarget = sCubeSource;
sCubeRef = '012_OPS_Monthly_Input';


sSourceScenario = 'BUDGET_N+1';
sTargetScenario = sSourceScenario;

vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewName = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName , 1);

#-- Subset creation on dimension Activity
sDim = 'Activity';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;

IF ( ELLEV( sDim , pActivity ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pActivity , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pActivity, vElt ) <> 0 & ELLEV( sDim, vElt )=0);
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Organization
sDim = 'Organization';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;

IF ( ELLEV( sDim , pOrganization ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pOrganization , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pOrganization, vElt ) <> 0 & ELLEV( sDim, vElt )=0);
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Customer_Top
sDim = 'Customer_Top';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;

IF ( ELLEV( sDim , pCustomer ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pCustomer , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pCustomer, vElt ) <> 0 & ELLEV( sDim, vElt )=0);
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Indicators_Op
sDim = 'Indicators_Op';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'Flag_Spread' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


# ==================================================================================
# -- MONTH SUBSET
# ==================================================================================
#-- Subset creation on dimension Months
sDim = 'Months';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget , 1);
ENDIF;
SubsetElementInsert( sDim , sSubsetNameTarget , 'Jan' , 1 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'Feb' , 2 );
SubsetElementInsert( sDim , sSubsetNameTarget, 'Mar' , 3 );
SubsetElementInsert( sDim , sSubsetNameTarget, 'Apr' , 4 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'May' , 5 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'Jun' , 6 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'Jul' , 7 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'Aug' , 8 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'Sep' , 9 );
SubsetElementInsert( sDim , sSubsetNameTarget, 'Oct' , 10 );
SubsetElementInsert( sDim , sSubsetNameTarget, 'Nov' , 11 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'Dec' , 12 );





# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#-- Assign the view to the process source
DataSourceNameForServer = sCubeSource;
DataSourceCubeView = sViewName;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

vInd = 'GM';

vSourceValue = CELLGETN ( sCubeSource , Currency , 'TOTAL_YEAR' , Activity , Organization , Customer_Top , vInd );

IF ( pProfil@='Personalized' & vSourceValue>=0);

	vDim2 = 'Months';
	k = 1;
	kMax = SubsetGetSize ( vDim2 , sSubsetNameTarget ) ;
	WHILE( k <= kMax );
		vMonth = SubsetGetElementName ( vDim2 , sSubsetNameTarget , k );
		IF( k<=9);
			pRatio = STRINGTONUMBEREX( EXPAND ( '%' | 'pM0' | NUMBERTOSTRING(k) |'%' ) , '.' , ',');
		ELSE;
			pRatio = STRINGTONUMBEREX( EXPAND ( '%' | 'pM' | NUMBERTOSTRING(k) |'%' ) , '.' , ',');	
		ENDIF;

		vMonth = SubsetGetElementName ( vDim2 , sSubsetNameTarget , k );

		#Ratio
		# In case where Value is positive and pRatio is positive or negative
		pGrowth =  pRatio / 100;
		# In case where Value is negative and pRatio is negative
		pGrowth2 = ABS( pRatio ) / 100 ;
		# In case where Value is negative and pRatio is positive
		pGrowth3 =  pRatio / 100 ;

		IF( vSourceValue > 0 );
			vNewValue = vSourceValue * pGrowth;
		ELSE;
			IF( pRatio< 0  );
				vNewValue = vSourceValue * pGrowth2;

			ELSE;
				vNewValue = vSourceValue * pGrowth3;
			ENDIF;
		ENDIF;
		
		IF( k=12 );
			vNovYTD = CELLGETN ( sCubeSource , Currency , 'YTD_Nov' , Activity , Organization , Customer_Top , vInd );
			CELLPUTN( vSourceValue - vNovYTD , sCubeTarget , Currency , vMonth ,  Activity , Organization , Customer_Top ,vInd );
		ELSE;
			CELLPUTN( vNewValue , sCubeTarget , Currency , vMonth ,  Activity , Organization , Customer_Top ,vInd );

		ENDIF;
		k= k + 1;	
	END; 

ENDIF;



IF ( pProfil @='1/12 Weight');

	vDim2 = 'Months';
	k = 1;
	kMax = SubsetGetSize ( vDim2 , sSubsetNameTarget ) ;
	WHILE( k <= kMax );
		vMonth = SubsetGetElementName ( vDim2 , sSubsetNameTarget , k );
		CELLPUTN( (1/12) * vSourceValue , sCubeTarget , Currency , vMonth ,  Activity , Organization , Customer_Top ,vInd );
		k= k + 1;	
	END; 

ENDIF;



IF ( pProfil @='Forecast Weight');

vRefGMYTD = CELLGETN ( sCubeRef , Currency , 'FCT_N', 'TOTAL_YEAR', Activity , 'TOTAL_FROM' ,'TOTAL_TO' , Organization , Customer_Top , vInd );

	IF(vRefGMYTD <> 0 );
		vDim2 = 'Months';
		k = 1;
		kMax = SubsetGetSize ( vDim2 , sSubsetNameTarget ) ;
		WHILE( k <= kMax );
			vMonth = SubsetGetElementName ( vDim2 , sSubsetNameTarget , k );
			vRefGMMTD = CELLGETN( sCubeRef ,Currency , 'FCT_N', vMonth, Activity , 'TOTAL_FROM' ,'TOTAL_TO' , Organization , Customer_Top , vInd );
			vGMWeight = vRefGMMTD/ vRefGMYTD;
			CELLPUTN( vSourceValue * vGMWeight , sCubeTarget , Currency , vMonth ,  Activity , Organization , Customer_Top ,vInd );
			k = k +1;
		END;
	ENDIF;


ENDIF;


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****




#endregion