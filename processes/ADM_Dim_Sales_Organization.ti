#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#####################################
# Project : RUBIKS
# Process : ADM_Dim_Sales_Organization
# Description : Init Sales_Organization 
# Created by : MBO
# Date : 17/07/2018
#####################################

# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

# ==================================================================================
# -- VARIABLES
# ==================================================================================
vDim = 'Sales_Organization';

Nb_Lign = 0 ;
Nb_Load = 0;

# ==================================================================================
# -- INIT OF DIMENSION
# ==================================================================================
IF( pInit = 1 );
	DIMENSIONDELETEALLELEMENTS(vDim);
ENDIF;

DIMENSIONSORTORDER(vDim,'BYINPUT','ASCENDING','BYHIERARCHY','ASCENDING');

vTotal='TOTAL_SALES_ORGANIZATION';

# ==================================================================================
# -- CREATION OF ATTRIBUTS
# ==================================================================================
vDimTech = '}ElementAttributes_'|vDim;

AttributeToAdd = 'Label';
AttributeToAddType = 'A';
IF ( DIMIX( vDimTech , AttributeToAdd ) = 0 );
	ATTRINSERT( vDim , '' , AttributeToAdd , AttributeToAddType );
ENDIF;



# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================
vCubeParam = 'z01_Admin_Param';


DatasourceNameForServer=CELLGETS(vCubeParam , 'DATASOURCE_NAME' , 'STR_VAR_S');
DatasourceUserName= CELLGETS(vCubeParam , 'DATASOURCE_USR' , 'STR_VAR_S');
DatasourcePassword= CELLGETS(vCubeParam , 'DATASOURCE_PWD' , 'STR_VAR_S');
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;


#================================================================
# INSERT DIMENSION ELEMENTS
#================================================================
DIMENSIONELEMENTINSERT(vDim,'',vTotal,'c');
DIMENSIONELEMENTINSERT(vDim,'',LVL10_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL9_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL8_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL7_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL6_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL5_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL4_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL3_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL2_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',LVL1_CD,'n');
DIMENSIONELEMENTINSERT(vDim,'',CLI_POS_LEADER_CD,'n');



DIMENSIONELEMENTCOMPONENTADD(vDim,vTotal,LVL10_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL10_CD,LVL9_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL9_CD,LVL8_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL8_CD,LVL7_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL7_CD,LVL6_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL6_CD,LVL5_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL5_CD,LVL4_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL4_CD,LVL3_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL3_CD,LVL2_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL2_CD,LVL1_CD,1.000000);
DIMENSIONELEMENTCOMPONENTADD(vDim,LVL1_CD,CLI_POS_LEADER_CD,1.000000);

#================================================================
# NUMBER OF ROW ( INSERT )
#================================================================
Nb_Load = Nb_Load+1;
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****



#================================================================
# ATTRIBUTS 
#================================================================

ATTRPUTS('Total Sales Organization',vDim, vTotal , 'Label');

ATTRPUTS(LVL10_LB,vDim, LVL10_CD , 'Label');
ATTRPUTS(LVL9_LB,vDim, LVL9_CD , 'Label');
ATTRPUTS(LVL8_LB,vDim, LVL8_CD , 'Label');
ATTRPUTS(LVL7_LB,vDim, LVL7_CD , 'Label');
ATTRPUTS(LVL6_LB,vDim, LVL6_CD , 'Label');
ATTRPUTS(LVL5_LB,vDim, LVL5_CD , 'Label');
ATTRPUTS(LVL4_LB,vDim, LVL4_CD , 'Label');
ATTRPUTS(LVL3_LB,vDim, LVL3_CD , 'Label');
ATTRPUTS(LVL2_LB,vDim, LVL2_CD , 'Label');
ATTRPUTS(LVL1_LB,vDim, LVL1_CD , 'Label');
ATTRPUTS(CLI_POS_LEADER_LB,vDim, CLI_POS_LEADER_CD , 'Label');


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);


# ==================================================================================
# -- Subset Alimentation
# ==================================================================================

# Subset Niv0
sSubsetName = '}RP_List_Level0_'|vDim;

sMDX = '{ORDER( {TM1SUBSETALL( ['|vDim|'] )}, ['|vDim|'].CurrentMember.Properties("Label"), BASC)}';

# -- Create the MDX
SUBSETDESTROY( vDim ,sSubsetName );
SUBSETCREATEBYMDX( sSubsetName , sMDX );

# -- Convert the MDX-based subset into a static subset
SubsetElementInsert( vDim , sSubsetName , Dfrst( vDim ), 1 );
SubsetElementDelete( vDim , sSubsetName , 1 );

SubsetAliasSet( vDim , sSubsetName , 'Label' );



#endregion