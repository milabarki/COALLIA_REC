#region Prolog
IF( pLockObj @<> '' ) ;
           SYNCHRONIZED( pLockObj ) ;
ENDIF ;

#****Begin: Generated Statements***
#****End: Generated Statements****



####################################
# Process : SCENARIO_ADM_IMP_Cube_024_Data_Loading
# Description : 024 data loading from flat file
# Created by : MBO
# Date : 31/03/2021
####################################


# ==================================================================================
# --  VARIABLES
# ==================================================================================
sCubeTarget = '024_Global_Input_Pilot';

vDim_Customer_Top = 'Customer_Top';
vDim_Customer_Actual = 'Customer_Actual';
vDim_Customer_Full = 'Customer_Full';
vTotal='TOTAL_CUSTOMER';


Nb_Lign = 0;

# Import Path
zServer = CELLGETS('z01_Admin_Param' , 'CONSO_SERVER_NAME' , 'STR_VAR_S');
zPath_Export = CELLGETS('z01_Admin_Param' , 'REP_EXPORT' , 'STR_VAR_S') | 'Pilot_Data\Input_Pilot\' ;
zFile_Name = 'Input_Pilot_' |pOrganization| '_Export_File.csv';
zFile_Import = zServer | zPath_Export | zFile_Name;

# Technical Path
zPath_Export_Tech = CELLGETS('z01_Admin_Param' , 'REP_EXPORT' , 'STR_VAR_S') | 'Technical\' ;
zFile_Folder_Tech = zServer | zPath_Export_Tech;



# Reject Path
zProcess = GetProcessName();
zPath_Reject = CELLGETS('z01_Admin_Param' , 'REP_REJECTS' , 'STR_VAR_S');
zFile_Name = zProcess | '_Rejects_File.csv';
zFile = zPath_Reject | zFile_Name;



# View creation
vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' | pOrganization| '_' |  GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' | pOrganization| '_' |  GetProcessName() ;



# ==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================
# -- Cube view name

ViewCreate( sCubeTarget , sViewNameTarget,1);

#-- Subset creation on dimension Organization
sDim = 'Organization_Pilot_Full';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget , 1);
ENDIF;
IF ( ELLEV( sDim , pOrganization ) =0 );

	SubsetElementInsert( sDim , sSubsetNameTarget , pOrganization , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pOrganization, vElt ) <> 0 );
			SubsetElementInsert( sDim , sSubsetNameTarget , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeTarget , sViewNameTarget , sDim , sSubsetNameTarget );

ViewZeroOut( sCubeTarget , sViewNameTarget );


# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

IF ( FileExists(zFile_Import )  = 0);
	PROCESSBREAK;
ENDIF;


DatasourceNameForServer=zFile_Import;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# INSERT DIMENSION ELEMENT
#================================================================

#-- Insert element in Customer_Actual dimension if it doesn't exist

IF( DIMIX( vDim_Customer_Actual , Customer ) = 0 );

	DIMENSIONELEMENTINSERT( vDim_Customer_Actual , '' , Customer , 'n' );

#-- Retrieve the HQ if it doesn't exist from Customer_Full dimension

	zHQ = ELPAR( vDim_Customer_Full , Customer , 1 );
	IF( zHQ @<> 'TOTAL_CUSTOMER' );
		IF(  DIMIX( vDim_Customer_Actual , Customer ) = 0 );
			DIMENSIONELEMENTINSERT( vDim_Customer_Actual , '' , zHQ , 'n' );
			DIMENSIONELEMENTCOMPONENTADD( vDim_Customer_Actual , vTotal , zHQ , 1.000000 );
			DIMENSIONELEMENTCOMPONENTADD( vDim_Customer_Actual , zHQ , Customer , 1.000000 );
		ELSE;
			DIMENSIONELEMENTCOMPONENTADD( vDim_Customer_Actual , vTotal , zHQ , 1.000000 );
			DIMENSIONELEMENTCOMPONENTADD( vDim_Customer_Actual , zHQ , Customer , 1.000000 );
		ENDIF;
	ELSE;
		DIMENSIONELEMENTCOMPONENTADD( vDim_Customer_Actual , vTotal , Customer , 1.000000 );
	ENDIF;

ENDIF;





#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;


# ==================================================================================
# -- DATA CONTROL
# ==================================================================================
Reject = 0;

vDim = 'Organization_Pilot_Full';
IF(DIMIX(vDim , Organization) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | organization | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'Customer_Actual';
IF(DIMIX(vDim , Customer) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | Customer | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'Carrier';
IF(DIMIX(vDim , Carrier) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | Carrier | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'Trade';
IF(DIMIX(vDim , Trade) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | Trade | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;



IF ( Reject <> 0 );
	ITEMSKIP;
ENDIF;



# ==================================================================================
# -- DATA LOADING
# ==================================================================================

CellIncrementN( Value , sCubeTarget, Scenario, Months  , Carrier ,  Trade , Organization , Customer , Indicator );

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****



ASCIIOUTPUT( zFile_Folder_Tech | pOrganization | '.txt' , pOrganization ) ;

#endregion