#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****



####################################
# Process : SCENARIO_ADM_IMP_Cube_030_Data_Loading
# Description : 030 data loading for ACT_N BUDGET_N
# Created by : MBO
# Date : 08/02/2018
# 2024/05/14 : Loading USD
####################################


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

Nb_Lign = 0 ;
Nb_Load = 0;


# ==================================================================================
# --  VARIABLES
# ==================================================================================
sCubeTarget = '030_Argos_Budget';



# Reject Path
zProcess = GetProcessName();
zPath_Reject = CELLGETS('z01_Admin_Param' , 'REP_REJECTS' , 'STR_VAR_S');
zFile_Name = zProcess | '_Rejects_File.csv';
zFile = zPath_Reject | zFile_Name;


# View creation
vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewNameTarget = 'Vue_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================
# -- Cube view name

ViewCreate( sCubeTarget , sViewNameTarget,1);
ViewZeroOut( sCubeTarget , sViewNameTarget );



# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================
vCubeParam = 'z01_Admin_Param';

sZone = CELLGETS( vCubeParam , 'ZONE', 'STR_VAR_S');

DatasourceNameForServer=CELLGETS(vCubeParam , 'DATASOURCE_NAME' , 'STR_VAR_S');
DatasourceUserName= CELLGETS(vCubeParam , 'DATASOURCE_USR' , 'STR_VAR_S');
DatasourcePassword= CELLGETS(vCubeParam , 'DATASOURCE_PWD' , 'STR_VAR_S');


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;


# ==================================================================================
# -- DATA CONTROL
# ==================================================================================
Reject = 0;

vDim = 'ARGOS_Organization';
IF(DIMIX(vDim , ORG_OCC_CD) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | ORG_OCC_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'ARGOS_Customer';
IF(DIMIX(vDim , CLI_CD) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | CLI_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'ARGOS_Product';
IF(DIMIX(vDim , CLI_PRD_CD) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | CLI_PRD_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'ARGOS_Activity';
IF(DIMIX(vDim , ACT_CD) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | ACT_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'ARGOS_Geo_From';
IF(DIMIX(vDim , LOC_LOAD_SUBCONT_CD) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | LOC_LOAD_SUBCONT_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'ARGOS_Geo_To';
IF(DIMIX(vDim ,LOC_OFFLOAD_SUBCONT_CD) = 0);
	sErrorMsg = 'Error Line ' | numbertostring(Nb_Lign) | ' : Element ' | LOC_OFFLOAD_SUBCONT_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( zFile , sErrorMsg);
	Reject = 1;
ENDIF;


IF ( Reject <> 0 );
	ITEMSKIP;
ENDIF;



# ==================================================================================
# -- DATA LOADING
# ==================================================================================
Level = ELLEV('ARGOS_Customer', CLI_CD);
CLI_CD=IF( Level<>0 , CLI_CD|'_X' , CLI_CD );

	# Set the tradelane from load and offload position
	TRADELANE = LOC_LOAD_SUBCONT_CD | SUBST( LOC_OFFLOAD_SUBCONT_CD , 6 , LONG( LOC_OFFLOAD_SUBCONT_CD ) );

	CELLPUTN( GM_EUR , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'GM' );
	CELLPUTN( GM_LCY , sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'GM' );
	CELLPUTN( TO_EUR , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TO' );
	CELLPUTN( TO_LCY, sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TO' );
	CELLPUTN( CHG_WEIGHT , sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD  , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'CW' );
	CELLPUTN( CHG_WEIGHT_PIL , sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD  , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'CW_PILOT' );
	CELLPUTN( TEUS_NB , sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TEUS' );
	CELLPUTN( TEUS_NB_PIL, sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TEUS_PILOT' );
	CELLPUTN( JF_NB , sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'JobFile_Nb' );
	CELLPUTN( FT , sCubeTarget , 'LCY' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'FT' );

	CELLPUTN( CHG_WEIGHT , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD  , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'CW' );
	CELLPUTN( CHG_WEIGHT_PIL , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD  , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'CW_PILOT' );
	CELLPUTN( TEUS_NB , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TEUS' );
	CELLPUTN( TEUS_NB_PIL, sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TEUS_PILOT' );
	CELLPUTN( JF_NB , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'JobFile_Nb' );
	CELLPUTN( FT , sCubeTarget , 'EUR' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'FT' );

# 2024/05/14 : Loading USD

	CELLPUTN( GM_USD , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'GM' );
	CELLPUTN( TO_USD , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TO' );
	CELLPUTN( CHG_WEIGHT , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD  , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'CW' );
	CELLPUTN( CHG_WEIGHT_PIL , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD  , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'CW_PILOT' );
	CELLPUTN( TEUS_NB , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TEUS' );
	CELLPUTN( TEUS_NB_PIL, sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'TEUS_PILOT' );
	CELLPUTN( JF_NB , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'JobFile_Nb' );
	CELLPUTN( FT , sCubeTarget , 'USD' , SCENARIO_CD , MONTH_CD , ACT_CD , CLI_PRD_CD , TRADELANE , ORG_OCC_CD ,  CLI_CD , 'FT' );


#================================================================
# NUMBER OF ROW ( INSERT )
#================================================================
Nb_Load = Nb_Load + 1 ;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);

#endregion