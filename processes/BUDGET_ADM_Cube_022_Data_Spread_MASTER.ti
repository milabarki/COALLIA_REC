# Flag correction
EXECUTEPROCESS('Z_ADM_FLAG_SPREAD_BUDGET_N+1_PILOT' , 'pOrganization', pOrganization );
EXECUTEPROCESS('Z_ADM_FLAG_SPREAD_BUDGET_N+1_PILOT_STEP2' , 'pOrganization', pOrganization );

# Spread operational data based on 7+5
EXECUTEPROCESS('BUDGET_ADM_Cube_022_Data_Spread_STEP1' , 'pOrganization', pOrganization , 'pType' , pType);
EXECUTEPROCESS('BUDGET_ADM_Cube_022_Data_Spread_STEP2' , 'pOrganization', pOrganization );
EXECUTEPROCESS('BUDGET_ADM_Cube_022_Data_Spread_STEP3' , 'pOrganization', pOrganization,  'pType' , pType );
EXECUTEPROCESS('BUDGET_ADM_Cube_022_Data_Spread_STEP4' , 'pOrganization', pOrganization , 'pType' , pType);


# Monthly breakdown  based on Actual N-1
EXECUTEPROCESS('BUDGET_ADM_Cube_022_Monthly_Breakdown_STEP1' , 'pOrganization', pOrganization , 'pType' , pType);
EXECUTEPROCESS('BUDGET_ADM_Cube_022_Monthly_Breakdown_STEP2' , 'pOrganization', pOrganization , 'pType' , pType);



# Data Copy to 021
EXECUTEPROCESS('SCENARIO_ADM_EXP_Cube_022_Init_to_Flat' , 'pOrganization', pOrganization , 'pType' , pType);
EXECUTEPROCESS('SCENARIO_ADM_IMP_Cube_021_Data_Loading' , 'pOrganization', pOrganization , 'pType' , pType);
