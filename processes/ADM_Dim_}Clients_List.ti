vDim = '}Clients';


# ==================================================================================
# -- Subset Alimentation
# ==================================================================================

# Subset Niv0
sSubsetName = '}RP_List_Level0_'|vDim;
sMDX = '{ORDER({TM1FILTERBYLEVEL( {TM1SUBSETALL( ['|vDim|'] )}, 0)}, ['|vDim|'].CurrentMember.Properties("}TM1_DefaultDisplayValue"), BASC)}';

# -- Create the MDX
SUBSETDESTROY( vDim ,sSubsetName );
SUBSETCREATEBYMDX( sSubsetName , sMDX );

# -- Convert the MDX-based subset into a static subset
SubsetMDXSet(vDim, sSubsetName, '' );


SubsetAliasSet( vDim , sSubsetName , '}TM1_DefaultDisplayValue' );


