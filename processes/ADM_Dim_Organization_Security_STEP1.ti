#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#####################################
# Project : RUBIKS
# Process : ADM_Dim_Organization_Security_STEP1
# Description : Init Organization_Security
# Created by : MBO
# Date : 15/04/2021
#####################################

# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

# ==================================================================================
# -- VARIABLES
# ==================================================================================
vDim = 'Organization_Security';

Nb_Lign = 0 ;
Nb_Load = 0;

# ==================================================================================
# -- INIT OF DIMENSION
# ==================================================================================
IF( pInit = 1 );
	DIMENSIONDELETEALLELEMENTS(vDim);
ENDIF;


DIMENSIONSORTORDER(vDim,'BYINPUT','ASCENDING','BYHIERARCHY','ASCENDING');

vTotal='TOTAL_ORGANIZATION';

# ==================================================================================
# -- CREATION OF ATTRIBUTS
# ==================================================================================
vDimTech = '}ElementAttributes_'|vDim;

AttributeToAdd = 'Label';
AttributeToAddType = 'A';
IF ( DIMIX( vDimTech , AttributeToAdd ) = 0 );
	ATTRINSERT( vDim , '' , AttributeToAdd , AttributeToAddType );
ENDIF;

AttributeToAdd = 'Level';
AttributeToAddType = 'S';
IF ( DIMIX( vDimTech , AttributeToAdd ) = 0 );
	ATTRINSERT( vDim , '' , AttributeToAdd , AttributeToAddType );
ENDIF;







# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================
vCubeParam = 'z01_Admin_Param';

sZone = CELLGETS( vCubeParam , 'ZONE', 'STR_VAR_S');

DatasourceNameForServer=CELLGETS(vCubeParam , 'DATASOURCE_NAME' , 'STR_VAR_S');
DatasourceUserName= CELLGETS(vCubeParam , 'DATASOURCE_USR' , 'STR_VAR_S');
DatasourcePassword= CELLGETS(vCubeParam , 'DATASOURCE_PWD' , 'STR_VAR_S');
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;


#================================================================
# INSERT DIMENSION ELEMENTS
#================================================================
DIMENSIONELEMENTINSERT(vDim,'',vTotal,'n');

IF( DIMIX(vDim, ORG_ZONE4_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_ZONE4_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_ZONE3_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_ZONE3_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_ZONE2_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_ZONE2_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_ZONE1_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_ZONE1_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_REGION_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_REGION_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_ER_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_ER_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_OBC_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_OBC_CD,'n');
ENDIF;

IF( DIMIX(vDim, ORG_OCC_FULL_CD)=0 );
	DIMENSIONELEMENTINSERT(vDim,'',ORG_OCC_FULL_CD,'n');
ENDIF;


#================================================================
# NUMBER OF ROW ( INSERT )
#================================================================
Nb_Load = Nb_Load+1;
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****



#================================================================
# ATTRIBUTS 
#================================================================

ATTRPUTS('Total Organization',vDim, vTotal , 'Label');
ATTRPUTS(ORG_OCC_LB,vDim, ORG_OCC_FULL_CD , 'Label');
ATTRPUTS(ORG_OBC_LB,vDim, ORG_OBC_CD , 'Label');
ATTRPUTS(ORG_ER_LB,vDim, ORG_ER_CD , 'Label');
ATTRPUTS(ORG_REGION_LB,vDim, ORG_REGION_CD , 'Label');
ATTRPUTS(ORG_ZONE1_LB,vDim, ORG_ZONE1_CD , 'Label');
ATTRPUTS(ORG_ZONE2_LB,vDim, ORG_ZONE2_CD , 'Label');
ATTRPUTS(ORG_ZONE3_LB,vDim, ORG_ZONE3_CD , 'Label');
ATTRPUTS(ORG_ZONE4_LB,vDim, ORG_ZONE4_CD , 'Label');

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);



#endregion