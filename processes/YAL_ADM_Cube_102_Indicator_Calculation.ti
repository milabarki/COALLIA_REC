#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

###################################################################################
# Process Name: YAL_ADM_Cube_102_Indicator_Calculation
# Description : Calculation of GM & TO in 101_YAL_Export Cube
# Created by : MBA - Datatilt
# Date : 23/06/2025
###################################################################################

# ==================================================================================
# --  VARIABLES
# ==================================================================================

# -- User Name
vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

# -- Cube Name
sCubeSource = '012_OPS_Monthly_Input' ;
sCubeTarget = '102_YAL_Export';

sCubeTransco = '100_YAL_Transco';
sCubeRate = '102_TO_Rate';
sCubeRate2 = '103_TO_Rate_Detail';

# -- View & Subset Names
sViewName  = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;

# -- Reject Path
zProcess = GetProcessName();
zPath_Reject = CELLGETS('z01_Admin_Param' , 'REP_REJECTS' , 'STR_VAR_S');
zFile_Name = zProcess | '_Rejects_File.csv';
zFile_Reject = zPath_Reject | zFile_Name;

# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName , 1);

#-- Subset creation on dimension Currency
sDim = 'Currency';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'LCY' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Scenario
sDim = 'Scenario';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'FCT_N' , 1 );
SubsetElementInsert( sDim , sSubsetName , 'BUDGET_N+1' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Organization  -----------------------------------------------------------------------------------------------------

sDim = 'Organization';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;

i = 1;
iMax = DIMSIZ ( sDim );
WHILE ( i <= iMax);
	vElt = DIMNM ( sDim  , i );
                  vCode_Hermes = CellGetS( sCubeTransco , vElt ,'STR_VAR_S');

	IF( ELLEV(sDim , vElt) = 0 & vCode_Hermes @= ' ' );
                                    #vER= ELPAR( sDim , (ELPAR(sDim , vElt,1)), 1);
		#SubsetElementInsert( sDim , sSubsetName , vER , 1 );
                                     SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
	ENDIF;
	i = i + 1;
END;

ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );




#-- Subset creation on dimension Indicators_Op
sDim = 'Indicators_Op';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'GM' , 1 );
SubsetElementInsert( sDim , sSubsetName , 'TO' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


# ==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================

ViewCreate( sCubeTarget , sViewNameTarget , 1);

sDim = 'Scenario';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetNameTarget , 'FCT_N' , 1 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'BUDGET_N+1' , 1 );
ViewSubsetAssign( sCubeTarget , sViewNameTarget , sDim , sSubsetNameTarget );


sDim = 'Indicators_Op';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetNameTarget , 'GM' , 1 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'TO' , 1 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'TO_CONSO' , 1 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'TO_G' , 1 );
ViewSubsetAssign( sCubeTarget , sViewNameTarget , sDim , sSubsetNameTarget );


ViewZeroOut( sCubeTarget , sViewNameTarget );


# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#-- Assign the view to the process source
DataSourceNameForServer = sCubeSource;
DataSourceCubeView = sViewName;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================================
# -- LOADING OF 101_YAL_EXPORT CUBE
# ==================================================================================

IF( Indicators_Op @= 'GM' );
	CELLINCREMENTN( Value , sCubeTarget , Scenario,Months, Organization , Activity, 'GM' );
	CELLINCREMENTN( Value , sCubeTarget , Scenario,'TOTAL_VALUE', Organization , Activity, 'GM' );
ENDIF;


# ********************************************************************************************************************************
IF( Indicators_Op @= 'TO' );

	CELLINCREMENTN( Value , sCubeTarget , Scenario, Months, Organization , Activity, 'TO' );
	CELLINCREMENTN( Value , sCubeTarget , Scenario,'TOTAL_VALUE', Organization , Activity, 'TO' );

     
                   # -- If Cube 1 has no data, retrieve data from Cube 2
	  vRate_Detail =  CELLGETN(sCubeRate2,  Scenario , Organization , Customer_Top, Geo_From, Geo_To,  'STR_VAR_N');
                                    
                     IF ( vRate_Detail <> 0);
                          vRate = vRate_Detail ;
                     Else;
                           vRate =CELLGETN(sCubeRate,  Scenario , Organization , 'STR_VAR_N');
                      ENDIF;
	
                  
	CELLINCREMENTN(vRate* Value , sCubeTarget , Scenario, Months, Organization , Activity, 'TO_CONSO' );
	CELLINCREMENTN(Value-(vRate* Value) , sCubeTarget , Scenario, Months, Organization , Activity, 'TO_G' );

	CELLINCREMENTN(vRate* Value , sCubeTarget , Scenario, 'TOTAL_VALUE', Organization , Activity, 'TO_CONSO' );
	CELLINCREMENTN(Value-(vRate* Value) , sCubeTarget , Scenario, 'TOTAL_VALUE', Organization , Activity, 'TO_G' );

ENDIF;






#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion