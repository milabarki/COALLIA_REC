#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#####################################
# Project : RUBIKS
# Process : ADM_Dim_Trade
# Description : Init Trade 
# Created by : MBO
# Date : 23/04/2018
#####################################

# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

# ==================================================================================
# -- VARIABLES
# ==================================================================================
vDim = 'Trade';



Nb_Lign = 0 ;
Nb_Load = 0;

# ==================================================================================
# -- INIT OF DIMENSION
# ==================================================================================
IF( pInit = 1 );
	DIMENSIONDELETEALLELEMENTS(vDim);
ENDIF;
DIMENSIONSORTORDER(vDim,'BYINPUT','ASCENDING','BYHIERARCHY','ASCENDING');


vTotal='TOTAL_TRADE';


# ==================================================================================
# -- CREATION OF ATTRIBUTS
# ==================================================================================
vDimTech = '}ElementAttributes_'|vDim;

AttributeToAdd = 'Label';
AttributeToAddType = 'A';
IF ( DIMIX( vDimTech , AttributeToAdd ) = 0 );
	ATTRINSERT( vDim , '' , AttributeToAdd , AttributeToAddType );
ENDIF;


# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================
vCubeParam = 'z01_Admin_Param';

DatasourceNameForServer=CELLGETS(vCubeParam , 'DATASOURCE_NAME' , 'STR_VAR_S');
DatasourceUserName= CELLGETS(vCubeParam , 'DATASOURCE_USR' , 'STR_VAR_S');
DatasourcePassword= CELLGETS(vCubeParam , 'DATASOURCE_PWD' , 'STR_VAR_S');
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;


#================================================================
# INSERT DIMENSION ELEMENTS
#================================================================
DIMENSIONELEMENTINSERT(vDim,'',vTotal,'c');
DIMENSIONELEMENTINSERT(vDim,'',TRD_CD,'n');


DIMENSIONELEMENTCOMPONENTADD(vDim,vTotal,TRD_CD,1.000000);


#================================================================
# NUMBER OF ROW ( INSERT )
#================================================================
Nb_Load = Nb_Load+1;
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# ATTRIBUTS 
#================================================================

ATTRPUTS('Total Trade',vDim, vTotal , 'Label');
ATTRPUTS(TRD_LB,vDim, TRD_CD , 'Label');

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- Subset Alimentation
# ==================================================================================

#Subset Level0 with Label
sSubsetName = '}RP_List_Level0_'|vDim;

sMDX = '{ORDER({TM1FILTERBYLEVEL( {TM1SUBSETALL( ['|vDim|'])}, 0)}, ['|vDim|'].CurrentMember.Properties("Label"), BASC)}';

# -- Create the MDX
SUBSETDESTROY( vDim , sSubsetName );
SUBSETCREATEBYMDX( sSubsetName , sMDX );

# -- Convert the MDX-based subset into a static subset
SubsetElementInsert( vDim , sSubsetName , Dfrst( vDim ), 1 );
SubsetElementDelete( vDim , sSubsetName , 1 );

SubsetAliasSet( vDim , sSubsetName, 'Label' );

#Subset Level0 without Label
sSubsetName = '}RP_List_Level0_WL_'|vDim;
sMDX = '{ORDER({TM1FILTERBYLEVEL( {TM1SUBSETALL( ['|vDim|'])}, 0)}, ['|vDim|'].CurrentMember.Properties("Label"), BASC)}';

# -- Create the MDX
SUBSETDESTROY( vDim , sSubsetName );
SUBSETCREATEBYMDX(sSubsetName , sMDX );

# -- Convert the MDX-based subset into a static subset
SubsetElementInsert( vDim , sSubsetName , Dfrst( vDim ), 1 );
SubsetElementDelete( vDim , sSubsetName , 1 );



# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);





#endregion