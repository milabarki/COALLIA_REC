#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

####################################
# Process : FORECAST_ADM_IMP_Cube_011_Data_Loading_STEP1
# Description : 011 Data Loading
# Created by : MBO
# Date : 23/04/2018
####################################


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

Nb_Lign = 0 ;
Nb_Load = 0;


# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCubeSource = '012_OPS_Monthly_Input' ;
sCubeTarget = '011_OPS_Yearly_Input' ;

# Reject Path
zProcess = GetProcessName();
zPath_Reject = CELLGETS('z01_Admin_Param' , 'REP_REJECTS' , 'STR_VAR_S');
zFile_Name = zProcess | '_Rejects_File.csv';
zFile = zPath_Reject | zFile_Name;


sSourceScenario = 'FCT_N';
sTargetScenario = sSourceScenario;
sRefScenario = 'ACT_N-1';

vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewName = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName , 1);

# ==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================

# -- Cube view name

ViewCreate( sCubeTarget , sViewNameTarget,1);
ViewZeroOut( sCubeTarget , sViewNameTarget );



# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#-- Assign the view to the process source
DataSourceNameForServer = sCubeSource;
DataSourceCubeView = sViewName;




#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;



# ==================================================================================
# -- DATA LOADING
# ==================================================================================

IF ( Indicators_Op@='GM' & Scenario@<>'ACT_N' & Scenario@<>'ACT_N-1'  );
	CELLINCREMENTN( Value , sCubeTarget , Currency , Scenario , Activity , Geo_From , Geo_To , Organization , Customer_Top , 'GM_TEMP' );
ELSE;
	IF( Indicators_Op@='TO' & Scenario@<>'ACT_N' & Scenario@<>'ACT_N-1'  );
		CELLINCREMENTN( Value , sCubeTarget , Currency , Scenario , Activity , Geo_From , Geo_To , Organization , Customer_Top , 'TO_TEMP' );
	ELSE;
		CELLINCREMENTN( Value , sCubeTarget , Currency , Scenario , Activity , Geo_From , Geo_To , Organization , Customer_Top , Indicators_Op );
	ENDIF;
ENDIF;

CELLPUTN( 1,  sCubeTarget , Currency , Scenario , Activity , Geo_From , Geo_To , Organization , Customer_Top , 'Flag_Spread');

# NUMBER OF ROW ( INSERT )
#================================================================
Nb_Load = Nb_Load+1;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);

#endregion