# ==================================================================================
# -- OTH SUBSET
# ==================================================================================
sSubsetName= '}Sub_Orga_' |'OTH_'|ORG_OCC_CD ;
sName = 'OTH_'|ORG_OCC_CD;
vDim='Customer_Actual_Init';

IF( SubsetExists( vDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( vDim , sSubsetName );
ELSE;
	SubsetCreate( vDim , sSubsetName );
ENDIF;
i = 1;
k =1;
iMax = DIMSIZ ( vDim );
WHILE ( i <= iMax);
	vElt = DIMNM ( vDim  , i );
	IF( ELISANC( vDim  , sName , vElt) <> 0 );
		SubsetElementInsert( vDim , sSubsetName , vElt , k );
		k = k + 1;
	ENDIF;
	i = i + 1;
END;


