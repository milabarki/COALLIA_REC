#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


####################################
# Project : RUBIKS
# Process : SECURITY_RP_Create_Password
# Description : Add user in table
# Created by : MBO
# Date : 21/12/2018
# Updated by : MTA
# Date : 08/09/2023
####################################



# ==================================================================================
# -- VARIABLE INITIALIZATION
# ==================================================================================
sDimClient = '}Clients';
sCubeInfo = 'z03_User_Infos';
sCubeParam = 'z01_Admin_Param';

# -- Verify if the user exists
IF( DIMIX( sDimClient , vLogin ) = 0 );
	ProcessQuit;
ENDIF;

sEmail = CELLGETS( sCubeInfo , vLogin , 'Email' );
sName = CELLGETS( sCubeInfo , vLogin , 'First_Name' ) | ' ' | CELLGETS( sCubeInfo , vLogin , 'Last_Name' );
sInstanceName = CELLGETS( sCubeParam , 'INSTANCE_NAME' , 'STR_VAR_S' );
sPortalLink = CELLGETS( sCubeParam , 'PORTAL_LINK' , 'STR_VAR_S' );


vServer=CELLGETS(sCubeParam , 'DATASOURCE_NAME' , 'STR_VAR_S');
vUserName= CELLGETS(sCubeParam , 'DATASOURCE_USR' , 'STR_VAR_S');
vPassword= CELLGETS(sCubeParam , 'DATASOURCE_PWD' , 'STR_VAR_S');

# ==================================================================================
# -- GENERATE PASSWORD
# ==================================================================================
# -- Generate 3 letters randomly
i = 1;
pwd = '';
WHILE( i <= 3 );
	letter_S = NUMBERTOSTRING( RAND() );
	letter_S = SUBST( letter_S , 3 , 2 );
	letter_N = STRINGTONUMBER( letter_S );
	WHILE ( letter_N < 65 % letter_N > 90 );
		letter = NUMBERTOSTRING( RAND() );
		letter = SUBST( letter , 3 , 2 );
		letter_N = STRINGTONUMBER( letter );
	END;
	pwd = pwd | CHAR( letter_N );
	i = i + 1;
END;
pwd = LOWER( pwd );

# -- Getting 3 numbers from RAND function
num_S = NUMBERTOSTRING( RAND() );
num_S = SUBST( num_S , 3 , 3 );

# -- The password will be composed of 3 letters and 3 numbers
pwd = pwd | num_S ;

# -- Assign the new password to the user
AssignClientPassword( vLogin , pwd );

# ==================================================================================
# -- SENT PASSWORD
# ==================================================================================
# -- Sent the new password to user by email
#sMsg = ' " Hello ' | sName | ',<br /><br /> Please find below your access information:<br />- Web Portal: ' | sPortalLink | '<br />- TM1 Server: ' | sInstanceName | '<br />- login: ' | vLogin | '<br />- password: ' | pwd | '<br /><br />Please remind that you have the possibility to customize your password by selecting the checkbox *Modify the password* on the portal.<br /><br />RUBIKS Support Team"';

#sCommand = CELLGETS( sCubeParam , 'REP_EMAILAPP' , 'STR_VAR_S' ) | ' -o message-content-type=html -f "RUBIKS <no-reply@by.bollore-logistics.com>"  -t ' | sEmail  | '  -s smtp.bollore-logistics.com:25 -u "[Account Creation]" -m ' |  sMsg ;
#ExecuteCommand(sCommand , 0);

ODBCOpen(vServer, vUserName, vPassword);

sSourceQuery = '
	exec msdb.dbo.sp_send_dbmail
	@profile_name=''INFOCENTRE DB''
	,@recipients= '' ' | sEmail | ' ''
	,@subject = ''Your Login & Password''
	,@body = ''Hello ' | sName | ',<br /><br /> Please find below your access information:<br />- Web Portal: ' | sPortalLink | '<br />- TM1 Server: ' | sInstanceName | '<br />- login: ' | vLogin | '<br />- password: ' | pwd | '<br /><br />Please remind that you have the possibility to customize your password by selecting the checkbox *Modify the password* on the portal.<br /><br />RUBIKS Support Team''
	 ,@body_format = ''HTML'';
	';

ODBCOutput(vServer, sSourceQuery);


ODBCClose(vServer);
#endregion
