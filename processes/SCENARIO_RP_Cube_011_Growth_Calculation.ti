#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

####################################
# Process : SCENARIO_RP_Cube_011_Growth_Calculation
# Description : 011 Growth Calculation 
# Created by : MBO
# Date : 25/05/2018
####################################

# ==================================================================================
# --  PROCESS CONTROL
# ==================================================================================

# Control
IF ( pStatus @<> 'N');
	PROCESSQUIT;
ENDIF;

#Ratio
# In case where Value is positive and pRatio is positive or negative
pGrowth = 1 + pRatio / 100 ;
# In case where Value is negative and pRatio is negative
pGrowth2 = 1 + ABS( pRatio ) / 100 ;
# In case where Value is negative and pRatio is positive
pGrowth3 = 1 + ( pRatio * -1 ) / 100 ;

# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCubeSource = '011_OPS_Yearly_Input' ;
sCubeTarget = sCubeSource;


sSourceScenario = pScenario;


vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewName = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName , 1);

#-- Subset creation on dimension Currency
sDim = 'Currency';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'LCY' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


#-- Subset creation on dimension Scenario
sDim = 'Scenario';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , sSourceScenario, 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Activity
sDim = 'Activity';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName,1 );
ENDIF;

IF ( ELLEV( sDim , pActivity ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pActivity , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pActivity, vElt ) <> 0 & ELLEV( sDim, vElt )=0);
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Customer_Top
sDim = 'Customer_Top';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;

IF ( ELLEV( sDim , pCustomer ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pCustomer , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pCustomer, vElt ) <> 0 & vElt@<>'TOTAL_OTHERS');
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Organization
IF ( pOrganization @<> 'TOTAL_ORGANIZATION' );
	sDim = 'Organization';
	IF( SubsetExists( sDim, sSubsetName ) = 1 );
		SubsetDeleteAllElements( sDim , sSubsetName );
	ELSE;
		SubsetCreate( sDim , sSubsetName, 1 );
	ENDIF;
	SubsetElementInsert( sDim , sSubsetName , pOrganization , 1 );
	ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );
ENDIF;

#-- Subset creation on dimension Indicators_Op

sDim = 'Indicators_Op';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'GM' , 1 );
SubsetElementInsert( sDim , sSubsetName , 'OTH_TEUS' , 2 );
SubsetElementInsert( sDim , sSubsetName , 'FP_TEUS' , 3 );
SubsetElementInsert( sDim , sSubsetName , 'OTH_CW' , 4 );
SubsetElementInsert( sDim , sSubsetName , 'FP_CW' , 5 );
SubsetElementInsert( sDim , sSubsetName , 'FT' , 6 );


ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );




# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#-- Assign the view to the process source
DataSourceNameForServer = sCubeSource;
DataSourceCubeView = sViewName;
#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- GROWTH CALCULATION AND LOADING
# ==================================================================================


IF (Scenario@='FCT_N');

	IF ( SUBST(Indicators_Op,1,3)@='OTH');
		vInd = SUBST(Indicators_Op , 5 , LONG(Indicators_Op) - 4);
		vFP = CELLGETN( sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top ,'FP_'|vInd );	
		IF (vFP = 0 );	
			vNewValue = Value * pGrowth;
			CELLPUTN( vNewValue  , sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top , 'OTH_'|vInd );
		ENDIF;

	ENDIF;

	IF (  SUBST(Indicators_Op,1,2)@='FP' );
		vInd = SUBST(Indicators_Op , 4 , LONG(Indicators_Op) - 3);
		vTOTAL = CELLGETN( sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top ,'TOTAL_'|vInd );
		vNewValue = vTOTAL * pGrowth;
		CELLPUTN( vNewValue - Value , sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top , 'OTH_'|vInd );

	ENDIF;
	IF (  Indicators_Op@='FT' );
		vNewValue = Value * pGrowth;
		CELLPUTN( vNewValue , sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top , Indicators_Op );
	ENDIF;
	IF (  Indicators_Op@='GM' & Value < 0);
		IF ( pRatio < 0 );
			vNewValue = Value * pGrowth2;
		ELSE;
			vNewValue = Value * pGrowth3;
		ENDIF;

			CELLPUTN( vNewValue , sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top , Indicators_Op );

	ELSE;
		IF (  Indicators_Op@='GM' );
			vNewValue = Value * pGrowth;
			CELLPUTN( vNewValue , sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top , Indicators_Op );	
		ENDIF;
	ENDIF;

ENDIF;



IF (Scenario@='BUDGET_N+1');
	IF ( Indicators_Op @= 'GM' & Value < 0 );
		IF ( pRatio < 0 );
			vNewValue = Value * pGrowth2;
		ELSE;
			vNewValue = Value * pGrowth3;
		ENDIF;
	ELSE;
		vNewValue = Value * pGrowth;
	ENDIF;
	CELLPUTN( vNewValue , sCubeTarget  , Currency ,Scenario,  Activity , Geo_From , Geo_To , Organization, Customer_Top , Indicators_Op );
ENDIF;
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****




#endregion