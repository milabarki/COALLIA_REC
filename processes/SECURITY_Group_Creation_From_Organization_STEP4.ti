# ==================================================================================
# -- INIT ORGANIZATION AVAILABILITY
# ==================================================================================



vValue = CELLGETS( sCubeWK ,'FCT_N','OPS' , vOrganization ,'Availability');
IF( vValue@='' );
	CELLPUTS( 'Unlock', sCubeWK , 'FCT_N' ,'OPS',  vOrganization ,'Availability');
ENDIF;


vValue = CELLGETS( sCubeWK ,'BUDGET_N+1','OPS' , vOrganization ,'Availability');
IF( vValue@='' );
	CELLPUTS( 'Unlock', sCubeWK , 'BUDGET_N+1' ,'OPS',  vOrganization ,'Availability');
ENDIF;



vValue = CELLGETS( sCubeWK ,'BUDGET_N+1','AIR' , vOrganization ,'Availability');
IF( vValue@='' );
	CELLPUTS( 'Unlock', sCubeWK , 'BUDGET_N+1' ,'AIR',  vOrganization ,'Availability');
ENDIF;

vValue = CELLGETS( sCubeWK ,'BUDGET_N+1','SEA' , vOrganization ,'Availability');
IF( vValue@='' );
	CELLPUTS( 'Unlock', sCubeWK , 'BUDGET_N+1' ,'SEA',  vOrganization ,'Availability');
ENDIF;

