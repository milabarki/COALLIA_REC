#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****



# ==================================================================================
# -- DATA CONTROL
# ==================================================================================
Reject = 0;

vDim = 'Organization_Pilot';
IF(DIMIX(vDim , ORG_OCC_CD) = 0);
	sErrorMsg = ORG_OCC_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( 'Reject.txt' , sErrorMsg);
	Reject = 1;
ENDIF;

vDim = 'Customer_Actual';

IF(DIMIX(vDim , CLI_CD) = 0);
	sErrorMsg =CLI_CD | ' does not exist in the dimension ' | vDim; 
	ASCIIOUTPUT( 'Reject.txt' , sErrorMsg);
	Reject = 1;
ENDIF;


IF ( Reject <> 0 );
	ITEMSKIP;
ENDIF;


SCENARIO_CD='BUDGET_N+1';
COM_CD='XXXXXX';
vTrade = 'XXXXX';
LOC_LOAD_CD='XXXXX';
LOC_OFFLOAD_CD='XXXXX';


# ==================================================================================
# -- DATA LOADING
# ==================================================================================

vDim = 'Months';

i = 1;
iMax = SubsetGetSize ( vDim , 'Test_Month');
WHILE( i <= iMax );
	vMonth = SubsetGetElementName ( vDim , 'Test_Month' , i );
	CELLPUTN( TEUS_NB/12 , sCubeTarget , SCENARIO_CD , vMonth ,  COM_CD ,vTrade , LOC_LOAD_CD ,  LOC_OFFLOAD_CD , ORG_OCC_CD , CLI_CD , 'TEUS');

	i = i + 1;
END;





