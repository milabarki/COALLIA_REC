#region Prolog


# ================================================================================================== 
# Process description: 
#           ADM_CALC_FIN_Reel_Recap_Vision_Temps
#
# -- Process Description : 
#           
#
# -- Process Version :
#                 1.0  - 03/04/2025 - MBA-Datatilt : Version initial
#                 1.1 -  10/04/2025 - MBO 
# ==================================================================================================


#Region *** Variables
# ****************************************
cProcessName = GetProcessName;
vParameterCubeName ='Z_Admin_Param';
sTm1userName= IF( SCAN ( '*' , TM1USER() ) <> 0 , 'ADMIN' , ATTRS( '}Clients', TM1User(), '}TM1_DefaultDisplayValue' ));
sTm1User = IF(SCAN( '/', sTm1userName )<>0, SUBST(sTm1userName,SCAN( '/', sTm1userName )+1,LONG( sTm1userName ) ), sTm1userName);

# -- Cubes Source
cSource_Cube = 'FIN_BUD_Reel_Reporting';
# -- Cubes Cible
cTarget_Cube1 = 'FIN_BUD_Reel_Reporting';
cTarget_Cube2 = 'Z_TMP_FIN_BUD_Reel_Reporting';

# -- Variables de rejets
cCube_Rejets = 'Z_Admin_Rejets' ;
nErrorLine = 0 ;
sRejectFile = CellGets(vParameterCubeName,'Data_Repertoire_Rejets','STR_VAR1')|cProcessName|'_Reject.csv';

pTemp = 1;

#EndRegion

#Region *** Vue cible
# ****************************************

#Region --- Vues & Subsets cibles
# -----------------------------------------
sView_Target = '}Temp_Target_View'|'_'| cTarget_Cube1 |'_'| sTm1user |'_'| cProcessName;
sSubset_Target = '}Temp_Target_Subset'|'_'| cTarget_Cube1 |'_'| sTm1user |'_'| cProcessName;
#EndRegion;

#Region --- Création de la vue
# -----------------------------------------
ViewDestroy(cTarget_Cube1, sView_Target);
ViewCreate(cTarget_Cube1, sView_Target, pTemp);
#EndRegion

#Region --- Création des subsets
# -----------------------------------------

# -- Création du subset pour la dimension Phase
cDim = 'Version';
cDimHierarchy = 'Version';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Target );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Target, pTemp );
HierarchySubsetElementInsert( cDim, cDimHierarchy, sSubset_Target, pPhase, 1 );
ViewSubsetAssign ( cTarget_Cube1 , sView_Target,  cDim, sSubset_Target ); 

# -- Création du subset pour la dimension Periode
cDim = 'Periode';
cDimHierarchy = 'Periode';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Target );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Target, pTemp );
sMDX = '{FILTER([Periode].[Periode].LEVELS(0).MEMBERS , [Periode].CURRENTMEMBER.PROPERTIES("Annee") = ' | pAnnee | ')}';
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Target, sMDX );
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Target, '' );
ViewSubsetAssign ( cTarget_Cube1 , sView_Target,  cDim, sSubset_Target ); 

# -- Création du subset pour la dimension Vison Temps
cDim = 'Vision_Temps';
cDimHierarchy = 'Vision_Temps';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Target );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Target, pTemp );
sMDX = '{EXCEPT(TM1FILTERBYLEVEL(TM1SUBSETALL([' | cDim | '].[' | cDim | ']) , 0) , {[' | cDim | '].[' | cDim | '].[MENSU]})}';
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Target, sMDX );
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Target, '' );
ViewSubsetAssign ( cTarget_Cube1 , sView_Target,  cDim, sSubset_Target ); 

# -- Création du subset pour la dimension Vison Temps
cDim = 'Indicateur_FIN';
cDimHierarchy = 'Indicateur_FIN';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Target );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Target, pTemp );
sMDX = '{EXCEPT(TM1FILTERBYLEVEL(TM1SUBSETALL([' | cDim | '].[' | cDim | ']) , 0) , {[' | cDim | '].[' | cDim | '].[SI]})}';
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Target, sMDX );
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Target, '' );
ViewSubsetAssign ( cTarget_Cube1 , sView_Target,  cDim, sSubset_Target ); 


#Region --- Target View Zero out
# -----------------------------------------
ViewZeroOut( cTarget_Cube1, sView_Target);
#EndRegion




#Region *** Vue source
# ****************************************

#Region --- Vues & Subsets sources
# -----------------------------------------
sView_Source = '}Temp_Source_View'|'_'| cSource_Cube |'_'| sTm1user |'_'| cProcessName;
sSubset_Source = '}Temp_Source_Subset'|'_'| cSource_Cube |'_'| sTm1user |'_'| cProcessName;
#EndRegion;

#Region --- Création de la vue
# -----------------------------------------
ViewDestroy(cSource_Cube, sView_Source);
ViewCreate(cSource_Cube, sView_Source, pTemp);
#EndRegion

#Region --- Création des subsets
# -----------------------------------------

# -- Création du subset pour la dimension Phase
cDim = 'Version';
cDimHierarchy = 'Version';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Source );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Source, pTemp );
HierarchySubsetElementInsert( cDim, cDimHierarchy, sSubset_Source, pPhase, 1 );
ViewSubsetAssign ( cSource_Cube , sView_Source,  cDim, sSubset_Source ); 


# -- Création du subset pour la dimension Periode
cDim = 'Periode';
cDimHierarchy = 'Periode';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Source );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Source, pTemp );
sMDX = '{FILTER([Periode].[Periode].LEVELS(0).MEMBERS , [Periode].CURRENTMEMBER.PROPERTIES("Annee") = ' | pAnnee | ')}';
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Source, sMDX );
HierarchySubsetMDXSet( cDim, cDimHierarchy, sSubset_Source, '' );
ViewSubsetAssign ( cSource_Cube , sView_Source,  cDim, sSubset_Source ); 

# -- Création du subset pour la dimension Vison Temps
cDim = 'Vision_Temps';
cDimHierarchy = 'Vision_Temps';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Source );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Source, pTemp );
HierarchySubsetElementInsert( cDim, cDimHierarchy, sSubset_Source, 'MENSU', 1 );
ViewSubsetAssign ( cSource_Cube , sView_Source,  cDim, sSubset_Source ); 

# -- Création du subset pour la dimension Vison Temps
cDim = 'Indicateur_FIN';
cDimHierarchy = 'Indicateur_FIN';
HierarchySubsetDestroy( cDim, cDimHierarchy, sSubset_Source );
HierarchySubsetCreate( cDim, cDimHierarchy, sSubset_Source, pTemp );
HierarchySubsetElementInsert( cDim, cDimHierarchy, sSubset_Source, 'C', 1 );
HierarchySubsetElementInsert( cDim, cDimHierarchy, sSubset_Source, 'D', 1 );
ViewSubsetAssign ( cSource_Cube , sView_Source,  cDim, sSubset_Source ); 
#EndRegion

#Region --- Paramètre de la source de données
# ----------------------------------------
ViewExtractSkipCalcsSet( cSource_Cube, sView_Source, 1 );
ViewExtractSkipRuleValuesSet(cSource_Cube, sView_Source, 1 );
ViewExtractSkipZeroesSet(cSource_Cube, sView_Source, 1 );
#EndRegion

#Region ---Configuration de la source de données
# ----------------------------------------
DataSourceType = 'View';
DataSourceNameForServer = cSource_Cube;
DataSourceCubeView = sView_Source;
#EndRegion

#EndRegion

#endregion
#region Data


#Region *** Chargement des données
# ****************************************


vAnnee = SUBST( vPeriode, 1,4);
vAnneeCumul = vAnnee;
CP=vCentre_Profit;

# --
i = 1;
iMax = 18 ;
WHILE ( i <= iMax );

    IF ( i < 10  ) ;
        vVisionPeriod = 'MG0'|NumberToString( i );
     ELSE;
        vVisionPeriod = 'MG'|NumberToString( i );
    ENDIF;

    IF (DIMIX( 'Vision_Temps', vVisionPeriod ) <> 0);
    	CellIncrementN( vValue, cTarget_Cube1  ,vVersion, vPeriode, vDomaine_Fonctionnel, vCentre_Profit, vPlan_Compte,  vVisionPeriod, vIndicateur_FIN);
        CellIncrementN( vValue, cTarget_Cube1  ,vVersion, vPeriode, vDomaine_Fonctionnel, vCentre_Profit, vPlan_Compte,  vVisionPeriod, 'S');
	ENDIF;
    
   IF(vAnnee @= vAnneeCumul);
        CellIncrementN( vValue, cTarget_Cube1  ,vVersion, vPeriode, vDomaine_Fonctionnel, vCentre_Profit, vPlan_Compte, 'CUMUL', vIndicateur_FIN);
        CellIncrementN( vValue, cTarget_Cube2  ,vVersion, vPeriode, vDomaine_Fonctionnel, vCentre_Profit, vPlan_Compte, 'CUMUL', vIndicateur_FIN);

        CellIncrementN( vValue, cTarget_Cube1  ,vVersion, vPeriode, vDomaine_Fonctionnel, vCentre_Profit, vPlan_Compte, 'CUMUL', 'S');
        CellIncrementN( vValue, cTarget_Cube2  ,vVersion, vPeriode, vDomaine_Fonctionnel, vCentre_Profit, vPlan_Compte, 'CUMUL', 'S');
       
   ENDIF;

    i = i +1;
vPeriode = ATTRS('Periode',vPeriode,'Periode_Suiv');
vAnneeCumul = subst(vPeriode,1,4);

End;


#endregion