#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


#####################################
# Project : RUBIKS
# Process : ADM_Dim_Sisyphe_Transco_CAO
# Description : Init Transco CAO
# Created by : MBO
# Date : 04/10/2017
#####################################

# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

# ==================================================================================
# -- VARIABLES
# ==================================================================================
vDim = 'Sisyphe_Transco_CAO';

Nb_Lign = 0 ;
Nb_Load = 0;

vCubeParam = 'z01_Admin_Param';

# Import Path
zPath_Import = CELLGETS( vCubeParam , 'REP_IMPORT_SISYPHE' , 'STR_VAR_S');
zFile_Name = 'ListeCAO.csv';
zFile_Import = zPath_Import | zFile_Name;

# ==================================================================================
# -- INIT OF DIMENSION
# ==================================================================================
IF( DIMIX( '}Dimensions' , vDim ) = 0 ) ;
	DIMENSIONCREATE( vDim ) ;
ENDIF ;

IF( pInit = 1 );
	DIMENSIONDELETEALLELEMENTS(vDim);
ENDIF;
DIMENSIONSORTORDER(vDim,'BYINPUT','ASCENDING','BYHIERARCHY','ASCENDING');


# ==================================================================================
# -- CREATION OF ATTRIBUTS
# ==================================================================================


# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================
DatasourceNameForServer=zFile_Import;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;



#================================================================
# INSERT DIMENSION ELEMENTS
#================================================================
DIMENSIONELEMENTINSERT(vDim,'',vCAO,'n');



#================================================================
# NUMBER OF ROW ( INSERT )
#================================================================
Nb_Load = Nb_Load+1;
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# ATTRIBUTS 
#================================================================


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****



# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);





#endregion