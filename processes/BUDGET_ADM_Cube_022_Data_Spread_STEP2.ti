#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****



####################################
# Process : BUDGET_ADM_Cube_022_Data_Spread_STEP2
# Description : 011 Data consolidation in z07
# Created by : MBO
# Date : 03/05/2018
####################################


# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCubeSource = '011_OPS_Yearly_Input' ;
sCubeTarget = 'z07_Conso_Spread';


# Extract Path
zServer = CELLGETS('z01_Admin_Param' , 'CONSO_SERVER_NAME' , 'STR_VAR_S');
zPath_Export = CELLGETS('z01_Admin_Param' , 'REP_EXPORT' , 'STR_VAR_S')|'Front_Office\RUBIKS\';


vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewName = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName , 1);

#-- Subset creation on dimension Scenario
sDim = 'Scenario';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'BUDGET_N+1' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Currency
sDim = 'Currency';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'LCY' , 1 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Organization
sDim = 'Organization';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;

IF ( ELLEV( sDim , pOrganization ) =0 );
	SubsetElementInsert( sDim , sSubsetName , pOrganization , 1 );
ELSE;
	i = 1;
	iMax = DIMSIZ( sDim );
	WHILE( i <= iMax );
		vElt = DIMNM ( sDim , i) ;
		IF ( ELISANC ( sDim , pOrganization, vElt ) <> 0 );
			SubsetElementInsert( sDim , sSubsetName , vElt , 1 );
		ENDIF;
		i = i + 1;
	END;
ENDIF;
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Indicators_Op
sDim = 'Indicators_Op';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'FP_TEUS',1 );
SubsetElementInsert( sDim , sSubsetName , 'FP_CW', 2 );
SubsetElementInsert( sDim , sSubsetName , 'Flag_Pilot_Air', 3 );
SubsetElementInsert( sDim , sSubsetName , 'Flag_Pilot_Sea', 4 );
ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================
# -- Cube view name

ViewCreate( sCubeTarget , sViewNameTarget,1);
ViewZeroOut( sCubeTarget , sViewNameTarget );


# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 0 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#-- Assign the view to the process source
DataSourceNameForServer = sCubeSource;
DataSourceCubeView = sViewName;


DatasourceASCIIQuoteCharacter = '';
DatasourceASCIIDelimiter = ';';



#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- DATA TRANSFERT 
# ==================================================================================

CELLINCREMENTN( Value,sCubeTarget , Geo_From , Geo_To , Organization , Customer_Top , Indicators_Op);



#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion