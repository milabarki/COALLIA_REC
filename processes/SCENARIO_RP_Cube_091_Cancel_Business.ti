#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

####################################
# Process : SCENARIO_RP_Cube_091_Cancel_Business
# Description : 091_New_Business : Cancel business for an oragnization from input screen
# Created by : MBO
# Date : 11/04/2017
####################################



# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCube = '091_New_Business' ;

vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewNameTarget = 'Vue_Target_Cube_' | sCube | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCube | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================

ViewCreate( sCube , sViewNameTarget , 1);


#-- Subset creation on dimension Organization
sDim = 'Organization';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget , 1);
ENDIF;
SubsetElementInsert( sDim , sSubsetNameTarget , pOrganization , 1 );
ViewSubsetAssign( sCube , sViewNameTarget , sDim , sSubsetNameTarget );

#-- Subset creation on dimension Scenario
sDim = 'Scenario';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget , 1);
ENDIF;
SubsetElementInsert( sDim , sSubsetNameTarget , pScenario , 1 );
ViewSubsetAssign( sCube , sViewNameTarget , sDim , sSubsetNameTarget );


ViewZeroOut( sCube , sViewNameTarget );


#endregion
#region Metadata

