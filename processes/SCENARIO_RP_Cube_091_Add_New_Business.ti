#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


####################################
# Process : SCENARIO_RP_Cube_091_Add_New_Business
# Description : 091_New_Business : Add new business from input screen
# Created by : MBO
# Date : 10/04/2019
####################################



# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCube = '091_New_Business';
sCube_Trade = '096_Trade';
sCube_Trade_EXCP = '097_Trade_EXCP';
vDim_Loading = 'Loading_Location_Full';
vDim_Offloading = 'Offloading_Location_Full';
zCustomer = DimensionElementPrincipalName( 'Customer_Full' , pCustomer );
zPOL = DimensionElementPrincipalName( vDim_Loading , pPOL );
zPOD = DimensionElementPrincipalName( vDim_Offloading , pPOD );
zActivity = DimensionElementPrincipalName( 'Activity' , pActivity );
zIncoterm = DimensionElementPrincipalName( 'Incoterm' , pIncoterm );
zNewBusiness = DimensionElementPrincipalName( 'New_Business_Type' , pNewB );

Nb_Rows= 0;

# ==================================================================================
# -- CONSISTENCY CHECK
# ==================================================================================
## -- Status
IF( pStatus @='Y');
	PROCESSQUIT;
ENDIF;


## -- Organization
IF ( ELLEV( 'Organization' , pOrganization ) <> 0  % pOrganization @= '' ) ;
	PROCESSQUIT;
ENDIF;


## -- Customer
IF ( ELLEV( 'Customer_Full' , pCustomer ) <> 0  % pCustomer @= '' % zCustomer @= 'X-XXXX'  );
	PROCESSQUIT;
ENDIF;


# -- Activity
IF ( ELLEV( 'Activity' , pActivity ) <> 0 % pActivity @= '' );
	PROCESSQUIT;
ENDIF;


# -- POL
IF ( ELLEV( vDim_Loading , pPOL ) <> 0 % pPOL @= '' %  pPOL@=pPOD );
	PROCESSQUIT;
ENDIF;


# -- POD
IF ( ELLEV( vDim_Offloading , pPOD ) <> 0 % pPOD @= ''  %  pPOL@=pPOD);
	PROCESSQUIT;
ENDIF;



# ==================================================================================
# -- Nb Row Check
# ==================================================================================


vDim = 'Nb_Rows';
i =1;
iMax = DIMSIZ(vDim);

WHILE ( i <= iMax );
	vValue = CELLGETN(sCube , pScenario ,pOrganization , NumberToString(i) , 'Insert');
	IF ( vValue = 0 );
		NbRow = i;
		i = iMax +1;
	ELSE;
		i = i + 1;
	ENDIF;

END;


# ==================================================================================
# -- Insert Flag
# ==================================================================================

nSize_Activity = LONG( zActivity );


IF( zActivity @= 'AIR_EXP' );
	CELLPUTN( 1 , sCube , pScenario ,  pOrganization , numbertostring(NbRow) , 'Flag');
ELSEIF( SUBST( zActivity , 1, 7 ) @= 'SEA_FCL' & SUBST( zActivity , nSize_Activity - 2 , nSize_Activity ) @= 'IMP' & zIncoterm @= 'COLL' );
	CELLPUTN( 1 , sCube , pScenario , pOrganization , numbertostring(NbRow) , 'Flag');
ELSEIF( SUBST( zActivity , 1, 7 ) @= 'SEA_FCL' & SUBST( zActivity , nSize_Activity - 2 , nSize_Activity ) @= 'EXP' & zIncoterm @= 'PREP' );	
	CELLPUTN( 1 , sCube , pScenario ,  pOrganization , numbertostring(NbRow) , 'Flag');
ENDIF;


# ==================================================================================
# -- Row insert
# ==================================================================================


# ==================================================================================
# --TRANSCODING
# ==================================================================================
vTrade = CELLGETS( sCube_Trade_EXCP , pPOL , pPOD , 'STR_VAR_S' );

IF( vTrade @= '');
	vCountry_From = ELPAR( vDim_Loading ,  pPOL , 1 );
	vCountry_To = ELPAR( vDim_Offloading ,  pPOD , 1 );
	vTrade = CELLGETS( sCube_Trade , vCountry_From , vCountry_To , 'STR_VAR_S' );
ENDIF;


vDim = 'Trade';

IF(DIMIX(vDim , vTrade) = 0);
	vTrade = 'XXXXX';
ENDIF;


CELLPUTS( zCustomer, sCube , pScenario ,pOrganization , numbertostring(NbRow) , 'Customer');
CELLPUTS( zPOL, sCube , pScenario ,pOrganization , numbertostring(NbRow) , 'POL');
CELLPUTS( zPOD, sCube , pScenario ,  pOrganization , numbertostring(NbRow) , 'POD');
CELLPUTS( zActivity, sCube , pScenario ,  pOrganization , numbertostring(NbRow) , 'Activity');
CELLPUTS( vTrade, sCube , pScenario , pOrganization , numbertostring(NbRow) , 'Trade');
CELLPUTS( 'YYYYYY', sCube , pScenario ,  pOrganization , numbertostring(NbRow) , 'Carrier');
CELLPUTN( 1 , sCube , pScenario , pOrganization , numbertostring(NbRow) , 'Insert');

IF( zNewBusiness@='Y1');
	CELLPUTN( 1 , sCube , pScenario , pOrganization , numbertostring(NbRow) , 'Flag_New_Business');
ENDIF;

IF( zNewBusiness@='Y2');
	CELLPUTN( 2 , sCube , pScenario , pOrganization , numbertostring(NbRow) , 'Flag_New_Business');
ENDIF;

IF( zNewBusiness@='N1');
	CELLPUTN( 0 , sCube , pScenario , pOrganization , numbertostring(NbRow) , 'Flag_New_Business');
ENDIF;


#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion