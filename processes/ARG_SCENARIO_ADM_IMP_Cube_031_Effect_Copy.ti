#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****


####################################
# Process : ARG_SCENARIO_ADM_IMP_Cube_031_Effect_Copy
# Description : 031
# Created by : MBO
# Date : 26/11/2021
# 2024/05/14 : Loading USD
####################################


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zProcess = GetProcessName();
zStart = NOW();

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Init', 
              'pProcess', zProcess
);

Nb_Lign = 0 ;
Nb_Load = 0;

# ==================================================================================
# --  VARIABLES
# ==================================================================================

sCubeSource = '031_Argos_Budget_Effect' ;
sCubeTarget = sCubeSource;
sCubeRef = 'z10_Argos_Effect_YTD';


vTM1USER = IF( SCAN ( '*' , TM1USER() ) <> 0 , DELET( TM1USER() , 2 , 1 ) , TM1USER());

sViewName = 'View_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;
sSubsetName = 'Subset_Source_Cube_' | sCubeSource | '_' | vTM1USER | '_' |   GetProcessName() ;

sViewNameTarget = 'View_Target_Cube_' | sCubeTarget | '_' | vTM1USER| '_' |   GetProcessName() ;
sSubsetNameTarget = 'Subset_Target_Cube_' | sCubeTarget | '_' | vTM1USER | '_' |   GetProcessName() ;


# ==================================================================================
# -- SOURCE VIEW CREATION
# ==================================================================================

ViewCreate( sCubeSource , sViewName , 1);


#-- Subset creation on dimension Currency
sDim = 'Currency';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'EUR' , 1 );

# 2024/05/21 :Add Effect for USD
SubsetElementInsert( sDim , sSubsetName , 'USD' , 1 );

ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension Scenario
sDim = 'ARGOS_Scenario';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'ACT_N' , 1 );

ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );

#-- Subset creation on dimension ARGOS_Indicators
sDim = 'ARGOS_Indicators';
IF( SubsetExists( sDim, sSubsetName ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetName );
ELSE;
	SubsetCreate( sDim , sSubsetName, 1 );
ENDIF;
SubsetElementInsert( sDim , sSubsetName , 'GM' , 1 );

ViewSubsetAssign( sCubeSource , sViewName , sDim , sSubsetName );


# ==================================================================================
# -- TARGET VIEW RESET
# ==================================================================================
# -- Cube view name

ViewCreate( sCubeTarget , sViewNameTarget,1);

#-- Subset creation on dimension ARGOS_Indicators
sDim = 'ARGOS_Indicators';
IF( SubsetExists( sDim, sSubsetNameTarget ) = 1 );
	SubsetDeleteAllElements( sDim , sSubsetNameTarget );
ELSE;
	SubsetCreate( sDim , sSubsetNameTarget , 1);
ENDIF;
SubsetElementInsert( sDim , sSubsetNameTarget , 'FX_EFF_VS_BUDGET_N' , 1 );
SubsetElementInsert( sDim , sSubsetNameTarget , 'FX_EFF_VS_ACT_N-1' , 2 );

ViewSubsetAssign( sCubeTarget , sViewNameTarget , sDim , sSubsetNameTarget );

ViewZeroOut( sCubeTarget , sViewNameTarget );


# ==================================================================================
# -- DATASOURCE PARAMETERS
# ==================================================================================

#-- Update the view parameters
ViewExtractSkipZeroesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipRuleValuesSet ( sCubeSource, sViewName , 1 );
ViewExtractSkipCalcsSet ( sCubeSource, sViewName , 1 );

#-- Assign the view to the process source
DataSourceNameForServer = sCubeSource;
DataSourceCubeView = sViewName;

#endregion
#region Metadata

#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****


#================================================================
# NUMBER OF ROW ( READ )
#================================================================
Nb_Lign = Nb_Lign + 1 ;

# ==================================================================================
# -- DATA LOADING
# ==================================================================================


IF( Months@='Jan');

	## BUDGET N ##
	vValue = CELLGETN(  sCubeRef , Currency , 'YTD_'|Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization , 'FX_EFF_VS_BUDGET_N' );
	CELLPUTN( vValue , sCubeTarget , Currency , Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization ,'FX_EFF_VS_BUDGET_N' );

	## ACT N-1 ##
	vValue = CELLGETN( sCubeRef , Currency , 'YTD_'|Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization , 'FX_EFF_VS_ACT_N-1' );
	CELLPUTN( vValue , sCubeTarget , Currency , Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization ,'FX_EFF_VS_ACT_N-1' );

ELSE;


	## BUDGET N ##
	vValueM = CELLGETN( sCubeRef , Currency , 'YTD_'|Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization , 'FX_EFF_VS_BUDGET_N' );
	vPrevMonth =ATTRS('Months' , Months ,'Previous Month Short');
	vValueM1= CELLGETN( sCubeRef , Currency , 'YTD_'|vPrevMonth , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization , 'FX_EFF_VS_BUDGET_N' );
	vValue = vValueM - vValueM1;
	CELLPUTN( vValue , sCubeTarget , Currency , Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization ,'FX_EFF_VS_BUDGET_N' );


	## ACT N-1 ##
	vValueM = CELLGETN( sCubeRef , Currency , 'YTD_'|Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization , 'FX_EFF_VS_ACT_N-1' );
	vPrevMonth =ATTRS('Months' , Months ,'Previous Month Short');
	vValueM1= CELLGETN( sCubeRef , Currency , 'YTD_'|vPrevMonth , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization , 'FX_EFF_VS_ACT_N-1' );
	vValue = vValueM - vValueM1;
	CELLPUTN( vValue , sCubeTarget , Currency , Months , ARGOS_Scenario, ARGOS_Activity ,ARGOS_Organization ,'FX_EFF_VS_ACT_N-1' );
	

ENDIF;


#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================================
# -- RUN FOLLOW
# ==================================================================================
zExecutionTime =ROUND((NOW()- zStart)*86400);

ExecuteProcess('Z_ADM_z02_Interf_Run_Follow_Log_Recording', 
              'pProcess', zProcess,
              'pNb_Lign', numbertostring(Nb_Lign),
              'pNb_Load', numbertostring(Nb_Load),
              'pExecTime', zExecutionTime
);


# ==================================================================================
# -- Flag last date
# ==================================================================================
zDate = TIMST ( NOW , '\Y-\m-\d')  ;

CELLPUTS( zDate ,'}ElementAttributes_}Processes', GetProcessName() ,'Last_Update');
#endregion